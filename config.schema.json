{
  "pluginAlias": "MonigearSNMP",
  "pluginType": "platform",
  "singular": false,
  "headerDisplay": "Connect Monigear network temperature, humidity, and air quality sensors to HomeKit via SNMP V2c. Supports MN-NTHM, MN-WTHM, MN-NCO2TH, and MN-NVOC.",
  "footerDisplay": "For IPv6 link-local addresses, include the interface suffix (e.g., `fe80::...%en0`). Install from GitHub: `npm install github:youruser/homebridge-monigear-snmp`",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Platform Name",
        "type": "string",
        "default": "MonigearSNMP",
        "description": "Platform instance name (shown in logs)"
      },
      "host": {
        "title": "Sensor Host",
        "type": "string",
        "description": "IPv4, IPv6, or IPv6 link-local address with interface (e.g., fe80::...%en0). Used for single-sensor setup."
      },
      "port": {
        "title": "SNMP Port",
        "type": "integer",
        "default": 161,
        "minimum": 1,
        "maximum": 65535
      },
      "community": {
        "title": "SNMP Read Community",
        "type": "string",
        "default": "public"
      },
      "pollInterval": {
        "title": "Poll Interval (seconds)",
        "type": "integer",
        "default": 30,
        "minimum": 5,
        "maximum": 300
      },
      "devices": {
        "title": "Multiple Sensors",
        "description": "Configure multiple sensors. If set, the top-level host/port/community are ignored.",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Sensor Name",
              "type": "string",
              "required": true,
              "description": "Display name in HomeKit"
            },
            "host": {
              "title": "Sensor Host",
              "type": "string",
              "required": true,
              "description": "IPv4, IPv6, or IPv6 link-local with interface"
            },
            "port": {
              "title": "SNMP Port",
              "type": "integer",
              "default": 161
            },
            "community": {
              "title": "SNMP Read Community",
              "type": "string",
              "default": "public"
            },
            "pollInterval": {
              "title": "Poll Interval (seconds)",
              "type": "integer",
              "default": 30,
              "minimum": 5,
              "maximum": 300
            }
          },
          "required": ["name", "host"]
        }
      }
    }
  },
  "layout": [
    "name",
    {
      "type": "fieldset",
      "title": "Single Sensor (simple setup)",
      "items": [
        "host",
        {
          "type": "flex",
          "flex-flow": "row wrap",
          "items": ["port", "community", "pollInterval"]
        }
      ]
    },
    {
      "type": "fieldset",
      "title": "Multiple Sensors (advanced)",
      "expandable": true,
      "items": [
        {
          "key": "devices",
          "type": "array",
          "items": [
            "devices[].name",
            "devices[].host",
            {
              "type": "flex",
              "flex-flow": "row wrap",
              "items": ["devices[].port", "devices[].community", "devices[].pollInterval"]
            }
          ]
        }
      ]
    }
  ]
}
